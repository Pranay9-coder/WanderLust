<% layout("layouts/boilerplate.ejs") %>

<section class="recommendation-page">
    <div class="recommendation-intro"><span class="eyebrow">WanderLust for you</span><h1>Find a stay that fits <em>your way.</em></h1><p>Tell us what matters—beaches, budget, family space, Wi-Fi, quiet corners—and we’ll rank the real listings that match.</p></div>
    <div class="recommendation-layout">
        <form id="recommendationForm" class="recommendation-form" novalidate>
            <div class="recommendation-form__header"><span class="planner-form__icon"><i class="bi bi-magic"></i></span><div><h2>Set your preferences</h2><p>Use a few words or fill in the details.</p></div></div>
            <div class="mb-3"><label class="form-label" for="recommendationPreferences">What kind of stay are you after?</label><textarea id="recommendationPreferences" name="preferences" class="form-control" rows="3" placeholder="Quiet beach stay for a family with Wi-Fi and a pool"></textarea></div>
            <div class="row g-3"><div class="col-md-6"><label class="form-label" for="recommendationLocation">Location</label><input class="form-control" id="recommendationLocation" name="location" placeholder="Goa"></div><div class="col-md-6"><label class="form-label" for="recommendationCategory">Category</label><select class="form-select" id="recommendationCategory" name="category"><option value="">Any category</option><% ['Beach','City','Mountain','Villa','Budget','Luxury','Nature'].forEach((category) => { %><option value="<%= category %>"><%= category %></option><% }) %></select></div><div class="col-md-6"><label class="form-label" for="recommendationMaxPrice">Maximum price / night</label><input class="form-control" id="recommendationMaxPrice" name="maxPrice" type="text" inputmode="numeric" pattern="[0-9]*" data-integer-only placeholder="5000"></div><div class="col-md-6"><label class="form-label" for="recommendationMinRating">Minimum rating</label><input class="form-control" id="recommendationMinRating" name="minRating" type="number" min="0" max="5" step="0.5" placeholder="4"></div><div class="col-12"><label class="form-label" for="recommendationAmenities">Must-have amenities</label><input class="form-control" id="recommendationAmenities" name="amenities" placeholder="Wi-Fi, Pool, Parking"></div></div>
            <button class="btn btn-primary btn-lg rounded-pill w-100 mt-4" type="submit"><i class="bi bi-magic me-2"></i>Find my matches</button>
            <p class="recommendation-disclaimer"><i class="bi bi-info-circle me-1"></i>Recommendations are ranked from listing price, location, category, rating, description, and amenities.</p>
        </form>
        <aside class="recommendation-aside"><span class="eyebrow">How it works</span><h2>Less scrolling. More “this is the one.”</h2><div class="recommendation-aside__points"><p><i class="bi bi-check2-circle"></i><span><strong>Real listings only</strong><small>No invented properties or details.</small></span></p><p><i class="bi bi-bar-chart"></i><span><strong>Transparent matching</strong><small>See why each stay was recommended.</small></span></p><p><i class="bi bi-sliders"></i><span><strong>Easy to refine</strong><small>Change your preferences anytime.</small></span></p></div></aside>
    </div>
    <section id="recommendationResults" class="recommendation-results d-none" aria-live="polite"></section>
</section>
