<% layout("layouts/boilerplate.ejs") %>

<section class="assistant-page">
    <div class="assistant-intro"><span class="eyebrow">WanderLust assistant</span><h1>Ask about the stays that could make your trip <em>special.</em></h1><p>Ask a natural travel question. The assistant searches real WanderLust listings first and shows which stays support its answer.</p></div>
    <div class="assistant-layout">
        <form id="assistantForm" class="assistant-form" novalidate><div class="assistant-form__header"><span class="assistant-form__icon"><i class="bi bi-chat-heart"></i></span><div><h2>What are you wondering?</h2><p>Try asking about location, budget, amenities, or travel style.</p></div></div><label class="form-label" for="assistantQuestion">Your question</label><textarea id="assistantQuestion" name="question" class="form-control assistant-textarea" rows="5" minlength="3" maxlength="1500" placeholder="Which properties are suitable for a quiet family trip near a beach?" required></textarea><div class="assistant-form__hint"><span><i class="bi bi-shield-check me-1"></i>Answers are grounded in listing data</span><span id="assistantCharacterCount">0 / 1500</span></div><button class="btn btn-primary btn-lg rounded-pill w-100 mt-4" type="submit"><i class="bi bi-send me-2"></i>Ask WanderLust</button></form>
        <aside class="assistant-aside"><span class="eyebrow">Try asking</span><button type="button" class="assistant-example" data-assistant-example="Which properties are suitable for a quiet family trip near a beach?"><i class="bi bi-arrow-up-right"></i><span>Which stays suit a quiet family beach trip?</span></button><button type="button" class="assistant-example" data-assistant-example="Show me affordable properties with good reviews and Wi-Fi."><i class="bi bi-arrow-up-right"></i><span>Show affordable stays with good reviews and Wi-Fi.</span></button><button type="button" class="assistant-example" data-assistant-example="What mountain properties are best for a peaceful weekend?"><i class="bi bi-arrow-up-right"></i><span>What mountain stays fit a peaceful weekend?</span></button><p class="assistant-aside__note"><i class="bi bi-info-circle me-1"></i>The assistant won’t claim details that aren’t present in the listings.</p></aside>
    </div>
    <section id="assistantResult" class="assistant-result d-none" aria-live="polite"></section>
</section>
