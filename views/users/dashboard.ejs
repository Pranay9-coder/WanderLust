<% layout("layouts/boilerplate.ejs") %>

<section class="page-header page-header--dashboard">
    <div><span class="eyebrow">Your WanderLust</span><h1>Welcome back, <%= user.username %>.</h1><p>Keep your saved places and upcoming escapes close at hand.</p></div>
    <a href="/listings" class="btn btn-primary"><i class="bi bi-compass me-2"></i>Explore stays</a>
</section>

<div class="dashboard-grid">
    <section class="dashboard-card dashboard-card--profile"><div class="dashboard-card__icon"><i class="bi bi-person"></i></div><span class="eyebrow">Profile</span><h2><%= user.username %></h2><p><%= user.email %></p><span class="status-dot">Active traveler</span></section>
    <section class="dashboard-card"><div class="d-flex justify-content-between align-items-center mb-3"><div><span class="eyebrow">Saved for later</span><h2>Favorites</h2></div><span class="stat-number"><%= favorites.length %></span></div><% if (favorites.length) { %><div class="mini-list"> <% favorites.slice(0, 3).forEach((listing) => { %><a href="/listings/<%= listing._id %>"><img src="<%= listing.image?.url || 'https://placehold.co/100x80' %>" alt=""><span><strong><%= listing.title %></strong><small><%= listing.location %></small></span><i class="bi bi-arrow-up-right"></i></a><% }) %></div><a class="text-link" href="/favorites">View all favorites <i class="bi bi-arrow-right"></i></a><% } else { %><div class="empty-state empty-state--compact"><i class="bi bi-heart"></i><p>No favorites yet.</p><a href="/listings" class="text-link">Explore stays <i class="bi bi-arrow-right"></i></a></div><% } %></section>
    <section class="dashboard-card"><div class="d-flex justify-content-between align-items-center mb-3"><div><span class="eyebrow">Your itinerary</span><h2>Bookings</h2></div><span class="stat-number"><%= bookings.length %></span></div><% if (bookings.length) { %><div class="mini-list"><% bookings.slice(0, 3).forEach((booking) => { %><a href="/bookings"><span class="date-badge"><%= new Date(booking.checkIn).toLocaleDateString('en-IN', { day: '2-digit', month: 'short' }) %></span><span><strong><%= booking.listing?.title || 'Listing removed' %></strong><small><%= booking.status %></small></span><i class="bi bi-arrow-up-right"></i></a><% }) %></div><a class="text-link" href="/bookings">View all bookings <i class="bi bi-arrow-right"></i></a><% } else { %><div class="empty-state empty-state--compact"><i class="bi bi-calendar-heart"></i><p>No bookings yet.</p><a href="/listings" class="text-link">Find your next stay <i class="bi bi-arrow-right"></i></a></div><% } %></section>
    <section class="dashboard-card dashboard-card--wide"><div class="d-flex justify-content-between align-items-center"><div><span class="eyebrow">Host tools</span><h2>My listings</h2></div><a href="/listings/new" class="btn btn-outline-dark rounded-pill">Add listing</a></div><div class="empty-state empty-state--compact"><i class="bi bi-house-add"></i><p>Listing ownership isn’t tracked yet. Create and manage stays from Explore.</p><a href="/listings" class="text-link">Browse listings <i class="bi bi-arrow-right"></i></a></div></section>
</div>
