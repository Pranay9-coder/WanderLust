<% layout("layouts/boilerplate.ejs") %>

<section class="page-header"><div><span class="eyebrow">Saved for later</span><h1>Your favorites</h1><p>Keep the places that made you pause close by.</p></div><a href="/listings" class="btn btn-primary rounded-pill"><i class="bi bi-compass me-2"></i>Explore more</a></section><div class="listing-results"><% if (listings.length === 0) { %><div class="empty-state"><i class="bi bi-heart"></i><h3>No favorites yet</h3><p>You haven’t saved any listings yet. Explore stays and keep your best finds handy.</p><a href="/listings" class="btn btn-primary rounded-pill">Explore listings</a></div><% } else { %><div class="listing-grid"><% listings.forEach((listing) => { %><%- include("../includes/listing-card.ejs", { listing, favoriteIds: new Set([String(listing._id)]) }) %><% }) %></div><% } %></div>
