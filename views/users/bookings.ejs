<% layout("layouts/boilerplate.ejs") %>

<section class="page-header"><div><span class="eyebrow">Your itinerary</span><h1>My bookings</h1><p>Everything you’re looking forward to, in one place.</p></div><a href="/listings" class="btn btn-primary rounded-pill"><i class="bi bi-compass me-2"></i>Find another stay</a></section><div class="listing-results"><% if (bookings.length === 0) { %><div class="empty-state"><i class="bi bi-calendar-heart"></i><h3>No bookings yet</h3><p>You don’t have any bookings yet. Start exploring to find your next stay.</p><a href="/listings" class="btn btn-primary rounded-pill">Explore stays</a></div><% } else { %><div class="vstack gap-3"><% bookings.forEach((booking) => { %><article class="dashboard-card"><div class="row align-items-center g-3"><div class="col-md-2"><img class="img-fluid rounded-3" src="<%= booking.listing?.image?.url || 'https://placehold.co/300x180/e7efe9/35564a?text=Stay' %>" alt="<%= booking.listing?.title || 'Listing removed' %>"></div><div class="col-md-5"><span class="eyebrow mb-1">Stay booked</span><h2 class="h5 mb-1"><%= booking.listing?.title || 'Listing removed' %></h2><p class="text-muted mb-0"><i class="bi bi-geo-alt"></i> <%= booking.listing?.location || 'Unknown location' %>, <%= booking.listing?.country || '' %></p></div><div class="col-md-3 small"><div><strong>Check-in</strong> <%= new Date(booking.checkIn).toLocaleDateString() %></div><div><strong>Check-out</strong> <%= new Date(booking.checkOut).toLocaleDateString() %></div><span class="badge mt-2 <%= booking.status === 'cancelled' ? 'bg-secondary' : 'bg-success' %>"><%= booking.status %></span></div><div class="col-md-2 text-md-end"><% if (booking.status !== 'cancelled') { %><form action="/bookings/<%= booking._id %>/cancel" method="POST"><button class="btn btn-outline-danger btn-sm rounded-pill" type="submit">Cancel booking</button></form><% } %></div></div></article><% }) %></div><% } %></div>
