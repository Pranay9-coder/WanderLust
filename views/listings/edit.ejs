<% layout("layouts/boilerplate.ejs") %>

<form id="editListingForm" method="post" action="/listings/<%= listing._id %>?_method=PUT" class="form-card needs-validation" novalidate><div class="form-card__intro"><span class="eyebrow">Keep the details fresh</span><h1>Edit listing</h1><p class="text-muted mb-0">Update how travelers experience this place.</p></div><div class="field-group"><h2><i class="bi bi-stars me-2 text-success"></i>Basic information</h2><div class="mb-3"><label class="form-label" for="title">Listing title</label><input class="form-control" id="title" type="text" name="listing[title]" value="<%= listing.title %>" required><div class="invalid-feedback">Please enter a title.</div></div><div><label class="form-label" for="description">Description</label><textarea class="form-control" id="description" name="listing[description]" rows="4" required><%= listing.description %></textarea><div class="invalid-feedback">Please add a short description.</div></div></div><div class="field-group"><h2><i class="bi bi-pin-map me-2 text-success"></i>Location & type</h2><div class="row g-3"><div class="col-md-6"><label class="form-label" for="location">City or location</label><input class="form-control" id="location" type="text" name="listing[location]" value="<%= listing.location %>" required><div class="invalid-feedback">Please enter a location.</div></div><div class="col-md-6"><label class="form-label" for="country">Country</label><input class="form-control" id="country" type="text" name="listing[country]" value="<%= listing.country %>" required><div class="invalid-feedback">Please provide a country.</div></div><div class="col-md-6"><label class="form-label" for="category">Category</label><select class="form-select" id="category" name="listing[category]"><% ['Beach','City','Mountain','Villa','Budget','Luxury','Nature'].forEach((category) => { %><option value="<%= category %>" <%= listing.category === category ? 'selected' : '' %>><%= category %></option><% }) %></select></div><div class="col-md-6"><label class="form-label" for="rating">Starting rating</label><input class="form-control" id="rating" type="number" min="0" max="5" step="0.5" name="listing[rating]" value="<%= listing.rating || '' %>"></div></div></div><div class="field-group"><h2><i class="bi bi-currency-rupee me-2 text-success"></i>Pricing & details</h2><div class="mb-3"><label class="form-label" for="price">Price per night</label><input class="form-control" id="price" type="number" min="1" step="1" name="listing[price]" value="<%= listing.price %>" required><div class="invalid-feedback">Price must be at least 1.</div></div><div class="mb-3"><label class="form-label" for="amenities">Amenities</label><input class="form-control" id="amenities" type="text" name="listing[amenities]" value="<%= Array.isArray(listing.amenities) ? listing.amenities.join(', ') : (listing.amenities || '') %>"></div><label class="form-label" for="image">Image URL</label><input class="form-control" id="image" type="url" name="listing[image]" value="<%= listing.image?.url || listing.image %>"></div><div class="d-flex justify-content-end gap-2"><a class="btn btn-outline-secondary rounded-pill" href="/listings/<%= listing._id %>">Cancel</a><button class="btn btn-primary rounded-pill px-4" type="submit"><i class="bi bi-check2 me-2"></i>Save changes</button></div></form>
