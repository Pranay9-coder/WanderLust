<% layout("layouts/boilerplate.ejs") %>

<form id="newListingForm" method="post" action="/listings/new" class="form-card needs-validation" novalidate><div class="form-card__intro"><span class="eyebrow">Share a place worth finding</span><h1>Create a listing</h1><p class="text-muted mb-0">Help travelers discover a stay they’ll remember.</p></div><div class="field-group"><h2><i class="bi bi-stars me-2 text-success"></i>Basic information</h2><div class="mb-3"><label class="form-label" for="title">Listing title</label><input class="form-control" id="title" type="text" name="listing[title]" placeholder="e.g. Sunlit villa by the sea" required><div class="invalid-feedback">Please enter a title.</div></div><div><label class="form-label" for="description">Description</label><textarea class="form-control" id="description" name="listing[description]" rows="4" placeholder="What makes this place special?" required></textarea><div class="invalid-feedback">Please add a short description.</div></div></div><div class="field-group"><h2><i class="bi bi-pin-map me-2 text-success"></i>Location & type</h2><div class="row g-3"><div class="col-md-6"><label class="form-label" for="location">City or location</label><input class="form-control" id="location" type="text" name="listing[location]" placeholder="Goa, India" required><div class="invalid-feedback">Please enter a location.</div></div><div class="col-md-6"><label class="form-label" for="country">Country</label><input class="form-control" id="country" type="text" name="listing[country]" placeholder="India" required><div class="invalid-feedback">Please provide a country.</div></div><div class="col-md-6"><label class="form-label" for="category">Category</label><select class="form-select" id="category" name="listing[category]"><% ['Beach','City','Mountain','Villa','Budget','Luxury','Nature'].forEach((category) => { %><option value="<%= category %>"><%= category %></option><% }) %></select></div><div class="col-md-6"><label class="form-label" for="rating">Starting rating</label><input class="form-control" id="rating" type="number" min="0" max="5" step="0.5" name="listing[rating]" placeholder="4.5"></div></div></div><div class="field-group"><h2><i class="bi bi-currency-rupee me-2 text-success"></i>Pricing & details</h2><div class="mb-3"><label class="form-label" for="price">Price per night</label><input class="form-control" id="price" type="number" min="1" step="1" name="listing[price]" placeholder="2500" required><div class="invalid-feedback">Price must be at least 1.</div></div><div class="mb-3"><label class="form-label" for="amenities">Amenities</label><input class="form-control" id="amenities" type="text" name="listing[amenities]" placeholder="Wi-Fi, Pool, Parking, Family friendly"></div><label class="form-label" for="image">Image URL <span class="text-muted fw-normal">(optional)</span></label><input class="form-control" id="image" type="url" name="listing[image]" placeholder="https://..."></div><div class="d-flex justify-content-end gap-2"><a class="btn btn-outline-secondary rounded-pill" href="/listings">Cancel</a><button class="btn btn-primary rounded-pill px-4" type="submit"><i class="bi bi-plus-lg me-2"></i>Add listing</button></div></form>
